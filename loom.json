{
  "$schema": "https://loomcode.dev/loom.schema.json",
  "version": 1,
  "test": "python3 -B scripts/check-pack.py",
  "targets": [
    {
      "id": "catalog",
      "name": "Template catalog",
      "kind": "url",
      "platform": "web",
      "command": "python3 -B scripts/preview.py",
      "health": "/health"
    }
  ],
  "secrets": {
    "RELEASE_GH_TOKEN": {
      "description": "GitHub token (exported to gh as GH_TOKEN) with contents:write on this repo, used to tag and publish the pack release (not needed if gh is already logged in on the releasing device)",
      "help": "https://github.com/settings/personal-access-tokens/new",
      "tiers": [
        "release"
      ],
      "required": false,
      "fallback": "uses the device's gh login"
    }
  },
  "smoke": "curl -fsS \"http://127.0.0.1:${PORT:-8000}/health\" | grep -q '\"packages\": [1-9]'",
  "release": "sh scripts/loom-release.sh"
}
